{{- /* Monitor manifest — typed dashboard. */ -}}
# Generated by Packwright /new-command. Edit by hand to extend.
#
# kind: monitor — declares a dashboard. Panels are wired in later MVPs once
# the loader gains the `monitor:` section; this stub establishes the slash
# command so the surface picks it up immediately.
schema_version: packwright.manifest.v1
kind: monitor
slash: {{ .Slash }}
title: {{ q .Title }}
{{- if .Form }}

# form: optional inputs (e.g. environment, region) referenced by panels.
form:
{{- range .Form }}
{{ renderField . -}}
{{- end }}
{{- end }}
