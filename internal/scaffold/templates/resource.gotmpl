{{- /* Resource manifest — provisions an AWS resource via IaC. */ -}}
# Generated by Packwright /new-command. Edit by hand to extend.
#
# kind: resource — provisions an AWS resource via an IaC template. The
# engine renders the form, fills `parameters_file`, and runs `deploy.script`.
schema_version: packwright.manifest.v1
kind: resource
slash: {{ .Slash }}
title: {{ q .Title }}

# template: where the IaC document lives and which engine renders it.
# Paths are resolved relative to this manifest file.
template:
  kind: {{ .Template.Kind }}
  path: {{ q .Template.Path }}
{{- if .Template.ParametersFile }}
  parameters_file: {{ q .Template.ParametersFile }}
{{- end }}

# deploy: how the rendered template is applied. The "script" driver shells
# out to a deploy script; the "sdk" driver (later MVPs) calls AWS directly.
# Values inside env may use Go-template syntax referencing form field IDs.
deploy:
  driver: {{ .Deploy.Driver }}
{{- if .Deploy.Script }}
  script: {{ q .Deploy.Script }}
{{- end }}
{{- if .Deploy.Env }}
  env:
{{- range envSorted .Deploy.Env }}
    {{ .Key }}: {{ q .Value }}
{{- end }}
{{- end }}
{{- if .Form }}

# form: inputs collected before deploy. Each entry becomes one widget in
# the wizard; cross-field dependencies declare via depends_on.
form:
{{- range .Form }}
{{ renderField . -}}
{{- end }}
{{- end }}
