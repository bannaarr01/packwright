{{- /* Composite manifest — chains existing slash commands. */ -}}
# Generated by Packwright /new-command. Edit by hand to extend.
#
# kind: composite — runs a sequence of existing slash commands. The
# step list lives in a future `composite:` section; this stub registers
# the slash command so the surface can present it immediately.
schema_version: packwright.manifest.v1
kind: composite
slash: {{ .Slash }}
title: {{ q .Title }}
{{- if .Form }}

# form: optional inputs forwarded to each composed step.
form:
{{- range .Form }}
{{ renderField . -}}
{{- end }}
{{- end }}
