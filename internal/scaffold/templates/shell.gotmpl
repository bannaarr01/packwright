{{- /* Shell manifest — runs a templated subprocess. */ -}}
# Generated by Packwright /new-command. Edit by hand to extend.
#
# kind: shell — runs a templated subprocess. The runtime substitutes form
# field IDs into command-array elements before invoking exec; see ADR-0014.
schema_version: packwright.manifest.v1
kind: shell
slash: {{ .Slash }}
title: {{ q .Title }}
{{- if .Form }}

# form: inputs collected before exec. Each value is substituted into the
# command via {{ "{{ .FieldID }}" }} placeholders.
form:
{{- range .Form }}
{{ renderField . -}}
{{- end }}
{{- end }}
